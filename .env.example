# ── 공통 ───────────────────────────────────────────────
AWS_REGION=us-east-1

# NBA 공식 YouTube 채널 (그대로 사용)
NBA_CHANNEL_ID=
NBA_CHANNEL_URL= 

# ── 방식 1: GPT 빌트인 웹검색 ──────────────────────────
# Bedrock API 키 (bedrock-mantle 엔드포인트 인증용, OpenAI SDK 호환)
# 발급: aws iam create-service-specific-credential --user-name <USER> --service-name bedrock.amazonaws.com
BEDROCK_API_KEY=여기에_Bedrock_API_키

# 웹검색 지원 모델 (GPT 계열만 빌트인 web_search 지원)
GPT_MODEL_ID=openai.gpt-5.6-terra

# 실시간 외부 웹 접근 여부
#   true  -> 실시간 공개 웹 검색 (bedrock-websearch:ExternalWebAccess 권한 필요)
#   false -> AWS 내부 인덱스/캐시만 사용 (추가 권한 불필요)
EXTERNAL_WEB_ACCESS=true

# ── 방식 2: AgentCore 에이전트 ─────────────────────────
# Claude 모델 (inference profile ID 사용 — on-demand 모델 ID는 불가)
CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-4-6

# AgentCore Gateway MCP URL (CloudFormation 스택 배포 후 출력값으로 채움)
AGENTCORE_GATEWAY_URL=https://<your-gateway>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
